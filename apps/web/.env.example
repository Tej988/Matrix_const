# Copy to .env.local and fill in. Not secret - these are public identifiers by
# design (SECURITY.md section 6). Security comes from Firestore Rules and App Check.
#
# Fastest way to get the Firebase values:
#   firebase login
#   firebase apps:sdkconfig WEB

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=

# Google Auth Platform -> Clients -> "Web client (auto created by Google Service)"
VITE_GOOGLE_OAUTH_CLIENT_ID=

# The shared Drive folder ID (ADR-009) - the last path segment of the folder URL
VITE_DRIVE_FOLDER_ID=1Azjoa4MqaYctoL9LKxbh2_trtXjlHviT

VITE_ENV=development

# true = talk to local emulators instead of live Firebase. Development only.
VITE_USE_EMULATORS=true

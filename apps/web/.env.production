# Production build overrides. Safe to commit - no secrets here.
#
# Vite loads .env.[mode] at higher priority than .env.local, so the Firebase
# config still comes from .env.local while these two are forced.
#
# VITE_USE_EMULATORS is pinned false as a second line of defence: lib/firebase.ts
# already refuses to connect to emulators outside a development build, but a
# deployed app pointing at localhost:8080 would be a silent, confusing failure.

VITE_ENV=production
VITE_USE_EMULATORS=false
